FROM php:8.4-fpm

# Install Nginx, Supervisor, Memcached, gettext-base (for envsubst), and PHP extensions
RUN apt-get update && apt-get install -y \
    nginx \
    supervisor \
    memcached \
    gettext-base \
    zip \
    unzip \
    git \
    libmemcached-dev \
    zlib1g-dev \
    && pecl install memcached \
    && docker-php-ext-enable memcached \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Composer
RUN php -r "readfile('https://getcomposer.org/installer');" | php -- --install-dir=/usr/bin/ --filename=composer

# Set working directory
WORKDIR /var/www/html

# Copy project files
COPY . .

# Install PHP dependencies
RUN composer install --no-interaction --prefer-dist --optimize-autoloader

# Copy Nginx config as a template (PORT will be substituted at runtime)
COPY nginx.railway.conf /etc/nginx/sites-available/default.template

# Copy Supervisor config (manages nginx, php-fpm, memcached)
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Make start script executable
RUN chmod +x /var/www/html/start.sh

# Fix permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

# Railway dynamically assigns $PORT
EXPOSE 80

CMD ["/var/www/html/start.sh"]
